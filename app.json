{
  "expo": {
    "name": "GradeLens",
    "slug": "gradelens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gradelensdisplaylogo512.png",
    "scheme": "gradelens",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gradelensdisplaylogo.png",
      "bundleIdentifier": "com.gradelens.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/gradelensdisplaylogo512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.um.gradelens",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/gradelensdisplaylogo512.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/gradelensdisplaylogo512.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GradeLens to use the camera to scan answer sheets.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58702853-87ea-4a4d-80d5-bed59e6ba23b"
      }
    }
  }
}
